LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_API_STYLE=auto
# Optional: if unset, the app can reuse ~/.zhsrc values:
# - ANTHROPIC_BASE_URL
# - ANTHROPIC_AUTH_TOKEN
# - ANTHROPIC_MODEL

PAPER_SOURCE=openalex
VERIFY_SSL=true
AUTO_FALLBACK=true
ALLOW_CACHE_FALLBACK=true

OPENALEX_API_KEY=
OPENALEX_EMAIL=you@example.com

SEMANTIC_SCHOLAR_API_KEY=
OPENREVIEW_BASE_URL=https://api2.openreview.net
FEISHU_WEBHOOK_URL=
ENABLE_FEISHU_WEBHOOK=false

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SSL=true
FROM_EMAIL=
TO_EMAIL=

# backward compatible (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
